# Supabase project settings (Project Settings > API Keys).
# Use the publishable key (sb_publishable_...). It is safe for the browser.
# Never put a secret key or the service-role key in client code or in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional text for the Unlock button, for example "$19". The real price is set in Stripe, not here.
VITE_PREMIUM_PRICE_LABEL=
